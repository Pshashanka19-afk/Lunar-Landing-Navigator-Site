NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Ephemeris configuration (options: 'spice', 'analytical', 'mock')
# Set EPHEMERIS_PROVIDER=spice and SPICE_ENABLED=true for real NAIF SPICE calculations
EPHEMERIS_PROVIDER=spice
SPICE_ENABLED=true
SPICE_KERNEL_DIR=./data/kernels
SPICE_FRAME=MOON_ME

# Terrain DEM configuration (options: 'geotiff', 'synthetic')
# Set DEM_PROVIDER=geotiff and DEM_PATH to real NASA LOLA GeoTIFF
DEM_PROVIDER=geotiff
DEM_PATH=./data/dem/lunar-south-pole.tif

# Terrain horizon sampling defaults
DEFAULT_HORIZON_RADIUS_METERS=1000
DEFAULT_AZIMUTH_STEP_DEG=5
DEFAULT_RADIAL_STEP_METERS=30

# Time-dependent window sampling defaults
DEFAULT_TIME_STEP_SECONDS=300
BOUNDARY_TOLERANCE_SECONDS=30
VISIBILITY_ANGULAR_TOLERANCE_DEG=0.1

# Safety & computation limits
MAX_MISSION_DURATION_DAYS=90
